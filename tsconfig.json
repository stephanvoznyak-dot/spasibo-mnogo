{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/crypto",
    "src/protocol",
    "src/storage",
    "src/swarm",
    "src/ui",
    "src/components",
    "src/version.ts",
    "src/standalone.tsx"
  ],
  "exclude": ["src/lib", "src/routes", "server", "node_modules"]
}
